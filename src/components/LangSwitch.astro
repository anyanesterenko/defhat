---
import { languages, langs, switchPath, type Lang } from '../i18n';
interface Props { lang: Lang; variant?: 'dark' | 'light' }
const { lang, variant = 'dark' } = Astro.props;
const names = { uk: 'Українська', en: 'English' };
---
<div class:list={['lang', `lang--${variant}`]} role="group" aria-label="Language / Мова">
  {langs.map((l) => (
    <a
      href={switchPath(Astro.url.pathname, l)}
      hreflang={l}
      lang={l}
      aria-label={names[l]}
      aria-current={l === lang ? 'true' : undefined}
      data-lang-link
    >{languages[l]}</a>
  ))}
</div>

<style>
  .lang {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line-dark-2);
    font-family: var(--mono);
    font-variation-settings: 'wdth' 87.5;
    font-size: 11px;
  }
  .lang a {
    padding: 6px 11px;
    border-radius: 999px;
    color: var(--muted-on-dark);
    transition: color 0.2s, background 0.2s;
  }
  .lang a:hover { color: #fff; }
  .lang a[aria-current='true'] { background: var(--copper); color: var(--black); }
</style>

<script>
  // Keep the current section when switching language
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => { if (location.hash) a.hash = location.hash; })
  );
</script>
