---
import Icon from './Icon.astro';
import { MARK_CREST, MARK_DOME } from '../brand';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
const nodes = d.nodes;

// Виноски креслення: точка на шоломі → підпис
const callouts = [
  { at: [92, 6], via: [92, -34], to: [250, -34], anchor: 'start', n: '01' },
  { at: [168, 128], via: [212, 96], to: [250, 96], anchor: 'start', n: '02' },
  { at: [40, 190], via: [-20, 150], to: [-72, 150], anchor: 'end', n: '03' },
  { at: [44, 284], via: [-20, 300], to: [-72, 300], anchor: 'end', n: '04' },
];
const rings = [1.22, 1.5, 1.84, 2.25, 2.75];
---
<section class="hero" aria-labelledby="hero-title" data-index="00">
  <div class="hero__noise" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow mono reveal"><span class="hero__dot"></span>{d.eyebrow}</p>
      <h1 id="hero-title" class="hero__title display reveal" style="--d:100ms" set:html={d.title} />
      <p class="hero__subtitle reveal" style="--d:200ms">{d.subtitle}</p>
      <div class="hero__actions reveal" style="--d:300ms">
        <a class="btn" href="#contacts">{d.primary}<Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#expertise">{d.secondary}</a>
      </div>
    </div>

    <div class="hero__visual">
      <svg class="bp" viewBox="-180 -70 520 460" role="img" aria-label={d.diagramLabel}>
        <defs>
          <path id="bp-dome" d={MARK_DOME} />
          <linearGradient id="bp-fill" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0" stop-color="#1c2590" />
            <stop offset="0.5" stop-color="#000978" />
            <stop offset="1" stop-color="#060a3a" />
          </linearGradient>
          <linearGradient id="bp-crest" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ecedef" />
            <stop offset="1" stop-color="#b1b1b3" />
          </linearGradient>
          <clipPath id="bp-clip"><path d={MARK_DOME} /><path d={MARK_CREST} /></clipPath>
        </defs>

        <!-- контурні «хвилі сигналу» у формі шолома -->
        <g class="bp__rings" fill="none">
          {rings.map((s, i) => (
            <use href="#bp-dome" class="bp__ring" style={`--i:${i}`}
              transform={`translate(91.5 200) scale(${s}) translate(-91.5 -200)`} />
          ))}
          <use href="#bp-dome" class="bp__pulse" transform="translate(91.5 200) scale(1) translate(-91.5 -200)" />
        </g>

        <!-- будівельні лінії -->
        <g class="bp__construct" fill="none">
          <path pathLength="1" class="draw" style="--d:.1s" d="M91.5 -60V385" stroke-dasharray="1" />
          <path pathLength="1" class="draw" style="--d:.2s" d="M-140 183.5H320" />
          <circle pathLength="1" class="draw" style="--d:.35s" cx="91.5" cy="165" r="83.5" />
          <circle pathLength="1" class="draw" style="--d:.45s" cx="91.5" cy="165" r="3" />
          <!-- розмірні лінії -->
          <path pathLength="1" class="draw dim" style="--d:.6s" d="M212 11V320.5M206 11H218M206 320.5H218" />
          <path pathLength="1" class="draw dim" style="--d:.7s" d="M8 352H175M8 346V358M175 346V358" />
        </g>
        <g class="bp__labels mono-svg">
          <text x="222" y="170" class="fade" style="--d:1.4s">328</text>
          <text x="91.5" y="372" text-anchor="middle" class="fade" style="--d:1.5s">167</text>
          <text x="-140" y="176" class="fade" style="--d:1.6s">Y 183.5</text>
          <text x="98" y="-50" class="fade" style="--d:1.6s">X 0.00</text>
          <text x="96" y="158" class="fade" style="--d:1.7s">R 83.5</text>
        </g>

        <!-- шолом -->
        <g class="bp__helmet">
          <path d={MARK_DOME} class="bp__fill" fill="url(#bp-fill)" />
          <path d={MARK_CREST} class="bp__fill bp__fill--crest" fill="url(#bp-crest)" />
          <g clip-path="url(#bp-clip)">
            <rect class="bp__scan" x="-10" y="0" width="200" height="2" fill="#c9cce6" />
          </g>
          <path d={MARK_DOME} pathLength="1" class="draw bp__stroke" style="--d:.5s; --dur:2s" />
          <path d={MARK_CREST} pathLength="1" class="draw bp__stroke bp__stroke--crest" style="--d:1.1s; --dur:1.2s" />
        </g>

        <!-- виноски: чотири напрями -->
        <g class="bp__callouts">
          {callouts.map((c, i) => (
            <g class="callout" style={`--d:${2.2 + i * 0.18}s`}>
              <circle cx={c.at[0]} cy={c.at[1]} r="3.2" class="callout__dot" />
              <path pathLength="1" class="draw callout__line" style={`--d:${2.2 + i * 0.18}s; --dur:.7s`}
                d={`M${c.at[0]} ${c.at[1]}L${c.via[0]} ${c.via[1]}H${c.to[0]}`} />
              <text x={c.to[0] + (c.anchor === 'start' ? 6 : -6)} y={c.to[1] - 7} text-anchor={c.anchor} class="callout__n">{c.n}</text>
              <text x={c.to[0] + (c.anchor === 'start' ? 6 : -6)} y={c.to[1] + 15} text-anchor={c.anchor} class="callout__t">{nodes[i]}</text>
            </g>
          ))}
        </g>
      </svg>
      <p class="hero__caption mono" aria-hidden="true"><span>{d.drawing}</span><span>DEFHAT · REV 2026</span></p>
    </div>
  </div>

  <div class="container hero__bottom">
    <a href="#about" class="hero__scroll mono">{d.scroll}<span></span></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(ellipse 45% 55% at 75% 40%, rgba(0, 9, 120, 0.45), transparent 70%),
      var(--black);
    color: var(--text-on-dark);
    padding-top: calc(var(--header-h) + clamp(32px, 6vw, 72px));
  }
  .hero__noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 45%, #000 20%, transparent 75%);
  }
  .hero__inner {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .hero__eyebrow { display: flex; align-items: center; gap: 12px; color: var(--muted-on-dark); }
  .hero__dot { width: 7px; height: 7px; background: var(--copper); box-shadow: 0 0 0 4px rgba(169, 173, 214, 0.18); animation: blink 2.4s infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }
  .hero__title { margin-top: 28px; font-size: clamp(38px, 4.5vw, 66px); }
  .hero__title :global(em) { color: #fff; }
  .hero__subtitle { margin-top: 28px; max-width: 52ch; font-size: clamp(16px, 1.4vw, 18px); color: var(--muted-on-dark); }
  .hero__actions { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__visual { position: relative; width: 100%; max-width: min(600px, 72svh); justify-self: end; }
  .hero__caption { display: flex; justify-content: space-between; margin-top: 4px; padding-top: 10px; border-top: 1px solid var(--line-dark); color: #8f93b8; font-size: 10px; }

  /* Blueprint */
  .bp { width: 100%; height: auto; overflow: visible; }
  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw var(--dur, 1.2s) var(--ease) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .fade { opacity: 0; animation: fade 0.8s ease forwards; animation-delay: var(--d, 0s); }
  @keyframes fade { to { opacity: 1; } }

  .bp__construct { stroke: rgba(255, 255, 255, 0.16); stroke-width: 0.6; }
  .bp__construct .dim { stroke: rgba(169, 173, 214, 0.55); }
  .mono-svg text, .callout text { font-family: var(--mono); font-variation-settings: 'wdth' 87.5; }
  .bp__labels { fill: #9da1c6; font-size: 7.5px; letter-spacing: 0.04em; }

  .bp__ring {
    stroke: rgba(124, 134, 255, 0.16);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    animation: fade 1.2s ease forwards;
    animation-delay: calc(1.6s + var(--i) * 0.12s);
  }
  .bp__pulse {
    stroke: rgba(169, 173, 214, 0.6);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transform-box: view-box;
    transform-origin: 91.5px 200px;
    opacity: 0;
    animation: pulse 4.5s cubic-bezier(0.2, 0.6, 0.3, 1) 3s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(3); opacity: 0; }
  }

  .bp__fill { opacity: 0; animation: fade 1.2s ease forwards 1.9s; }
  .bp__fill--crest { animation-delay: 2.2s; }
  .bp__stroke { fill: none; stroke: var(--sand); stroke-width: 1.1; stroke-linejoin: round; }
  .bp__stroke--crest { stroke: var(--copper); }
  .bp__scan {
    opacity: 0;
    animation: scan 5s linear 3s infinite;
  }
  @keyframes scan {
    0% { transform: translateY(0); opacity: 0; }
    8% { opacity: 0.55; }
    92% { opacity: 0.55; }
    100% { transform: translateY(330px); opacity: 0; }
  }

  .callout__dot { fill: var(--copper); opacity: 0; animation: fade 0.4s ease forwards; animation-delay: var(--d); }
  .callout__line { fill: none; stroke: rgba(255, 255, 255, 0.45); stroke-width: 0.7; }
  .callout__n { fill: var(--copper); font-size: 7.5px; opacity: 0; animation: fade 0.6s ease forwards; animation-delay: calc(var(--d) + 0.5s); }
  .callout__t { fill: var(--text-on-dark); font-family: var(--font) !important; font-size: 13px; font-weight: 400; opacity: 0; animation: fade 0.6s ease forwards; animation-delay: calc(var(--d) + 0.55s); }

  .hero__bottom {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 24px;
    margin-top: clamp(32px, 5vw, 56px);
    padding-bottom: 28px;
  }
  .hero__scroll { display: inline-flex; align-items: center; gap: 12px; color: var(--muted-on-dark); }
  .hero__scroll span { position: relative; width: 1px; height: 40px; background: var(--line-dark-2); overflow: hidden; }
  .hero__scroll span::after { content: ''; position: absolute; left: 0; top: -40%; width: 1px; height: 40%; background: var(--copper); animation: drop 1.8s var(--ease) infinite; }
  @keyframes drop { to { top: 100%; } }

  @media (max-width: 1000px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { justify-self: center; max-width: 520px; margin-top: 16px; }
      .hero__scroll { display: none; }
  }
  @media (max-width: 560px) {
        .callout__t { font-size: 16px; }
  }
</style>
