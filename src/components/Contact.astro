---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { MARK_CREST, MARK_DOME } from '../brand';
import { t, url, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).contact;
const f = d.form;
const tel = d.phone.replace(/[^\d+]/g, '');
---
<section id="contacts" class="section section--dark contact" aria-labelledby="contact-title" data-index="05" data-contact>
  <svg class="contact__helmet" viewBox="-120 -40 422 420" aria-hidden="true">
    {[1, 1.3, 1.65, 2.05].map((s, i) => (
      <path class="ring" d={MARK_DOME} style={`--i:${i}`} transform={`translate(91.5 200) scale(${s}) translate(-91.5 -200)`} />
    ))}
    <path class="outline" pathLength="1" d={MARK_DOME} />
    <path class="outline outline--crest" pathLength="1" d={MARK_CREST} />
  </svg>
  <div class="container contact__inner">
    <div class="contact__info">
      <SectionHead index={5} label={d.eyebrow} title={d.title} lead={d.lead} id="contact-title" />

      <ul class="channels reveal" style="--d:200ms">
        <li>
          <a href={`mailto:${d.email}`} class="channel">
            <span class="channel__icon"><Icon name="mail" /></span>
            <span><small class="mono">{d.emailLabel}</small>{d.email}</span>
          </a>
        </li>
        <li>
          <a href={`tel:${tel}`} class="channel">
            <span class="channel__icon"><Icon name="phone" /></span>
            <span><small class="mono">{d.phoneLabel}</small>{d.phone}</span>
          </a>
        </li>
      </ul>
    </div>

    <form
      class="form reveal"
      style="--d:120ms"
      novalidate
      data-form
      data-endpoint={import.meta.env.PUBLIC_FORM_ENDPOINT ?? ''}
      data-key={import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? ''}
      data-dev={import.meta.env.DEV ? '1' : ''}
      data-lang={lang}
      data-err-required={f.errors.required}
      data-err-email={f.errors.email}
      data-err-short={f.errors.short}
    >
      <div class="form__row">
        <div class="field">
          <label for="f-name">{f.name} <span aria-hidden="true">*</span></label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="f-name-err" />
          <p class="field__err" id="f-name-err"></p>
        </div>
        <div class="field">
          <label for="f-email">{f.email} <span aria-hidden="true">*</span></label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="f-email-err" />
          <p class="field__err" id="f-email-err"></p>
        </div>
      </div>
      <div class="field">
        <label for="f-company">{f.company} <span class="field__opt">({f.optional})</span></label>
        <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="160" />
      </div>
      <div class="field">
        <label for="f-message">{f.message} <span aria-hidden="true">*</span></label>
        <textarea id="f-message" name="message" rows="5" required minlength="10" maxlength="3000" placeholder={f.messagePlaceholder} aria-describedby="f-message-err"></textarea>
        <p class="field__err" id="f-message-err"></p>
      </div>

      <!-- anti-spam honeypot -->
      <div class="hp" aria-hidden="true">
        <label for="f-website">Website</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__foot">
        <p class="form__consent">{f.consent} <a href={url(`${lang}/privacy/`)}>{f.privacy}</a>.</p>
        <button class="btn" type="submit" data-submit>
          <span data-label>{f.submit}</span>
          <span data-sending hidden>{f.sending}</span>
          <Icon name="arrow" />
        </button>
      </div>

      <div class="form__status" role="status" aria-live="polite" data-status>
        <div class="notice notice--ok" data-ok hidden><Icon name="check" /><span>{f.success}</span></div>
        <div class="notice notice--err" data-err hidden><Icon name="alert" /><span>{f.error}</span></div>
      </div>
    </form>
  </div>
</section>

<style>
  .contact { overflow: hidden; }
  .contact__helmet {
    position: absolute;
    right: -4%;
    bottom: -18%;
    width: min(70vw, 900px);
    pointer-events: none;
    fill: none;
  }
  .contact__helmet .ring { stroke: rgba(124, 134, 255, 0.12); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .contact__helmet .outline { stroke: rgba(255, 255, 255, 0.24); stroke-width: 1; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 3s var(--ease); }
  .contact__helmet .outline--crest { stroke: rgba(169, 173, 214, 0.6); transition-delay: 0.8s; }
  .contact.is-visible .contact__helmet .outline { stroke-dashoffset: 0; }

  .contact__inner {
    position: relative;
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(40px, 6vw, 104px);
    align-items: start;
  }
  .channels { margin-top: 48px; border-top: 1px solid var(--line-dark-2); }
  .channel {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 300;
    letter-spacing: -0.01em;
    transition: color 0.3s, padding 0.5s var(--ease);
  }
  .channel:hover { color: var(--copper-2); padding-left: 8px; }
  .channel small { display: block; margin-bottom: 4px; color: var(--muted-on-dark); font-size: 10.5px; }
  .channel__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--royal-2), var(--royal));
    color: #fff;
  }
  .channel__icon :global(svg) { width: 20px; height: 20px; stroke-width: 1.4; }

  .form {
    position: relative;
    display: grid;
    gap: 22px;
    padding: clamp(24px, 3.5vw, 48px);
    border-radius: var(--card-r);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--line-dark);
  }
  /* кольорове світіння за формою */
  .form::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 20% -10% -10% 30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 9, 120, 0.5), rgba(169, 173, 214, 0.12) 50%, transparent 70%);
    filter: blur(60px);
  }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .field { display: grid; gap: 8px; min-width: 0; }
  .field label { font-size: 14px; font-weight: 400; color: var(--muted-on-dark); }
  .field label span[aria-hidden] { color: var(--copper); }
  .field__opt { opacity: 0.7; }
  .field input,
  .field textarea {
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--line-dark-2);
    border-radius: 0;
    background: transparent;
    color: #fff;
    font-size: 17px;
    font-weight: 300;
    transition: border-color 0.3s;
  }
  .field textarea { resize: vertical; min-height: 110px; }
  .field input::placeholder,
  .field textarea::placeholder { color: #8f93b8; }
  .field input:hover,
  .field textarea:hover { border-color: rgba(255, 255, 255, 0.35); }
  .field input:focus,
  .field textarea:focus { outline: none; border-color: var(--copper); }
  .field [aria-invalid='true'] { border-color: #ff6b5e; }
  .field__err { font-size: 13px; color: #ff8a7f; }
  .field__err:empty { display: none; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .form__foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 8px; }
  .form__consent { font-size: 13px; color: var(--muted-on-dark); max-width: 34ch; }
  .form__consent a { color: var(--text-on-dark); text-decoration: underline; text-underline-offset: 3px; }
  .btn[disabled] { opacity: 0.7; cursor: progress; }

  .notice {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    font-size: 15px;
    animation: pop 0.4s var(--ease);
  }
  .notice :global(svg) { width: 20px; height: 20px; flex: none; margin-top: 1px; }
  .notice { border-radius: 14px; }
  .notice--ok { background: rgba(124, 134, 255, 0.14); color: #a9ecf2; }
  .notice--err { background: rgba(255, 107, 94, 0.12); color: #ffb1a9; }
  .notice[hidden] { display: none; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } }

  @media (max-width: 960px) {
    .contact__inner { grid-template-columns: 1fr; }
    .contact__helmet { width: 120vw; right: -40%; bottom: auto; top: 10%; }
  }
  @media (max-width: 560px) {
    .form__row { grid-template-columns: 1fr; }
    .form__foot { flex-direction: column-reverse; align-items: stretch; }
    .form__foot .btn { width: 100%; }
  }
</style>

<script>
  const contact = document.querySelector<HTMLElement>('[data-contact]');
  if (contact) {
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { contact.classList.add('is-visible'); o.disconnect(); } }, { threshold: 0.2 }).observe(contact);
  }
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const startedAt = Date.now();
    const ds = form.dataset;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const sending = form.querySelector<HTMLElement>('[data-sending]')!;
    const ok = form.querySelector<HTMLElement>('[data-ok]')!;
    const err = form.querySelector<HTMLElement>('[data-err]')!;
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    const fields = {
      name: form.elements.namedItem('name') as HTMLInputElement,
      email: form.elements.namedItem('email') as HTMLInputElement,
      message: form.elements.namedItem('message') as HTMLTextAreaElement,
    };

    const check = (key: keyof typeof fields): boolean => {
      const el = fields[key];
      const v = el.value.trim();
      let msg = '';
      if (!v) msg = ds.errRequired!;
      else if (key === 'email' && !emailRe.test(v)) msg = ds.errEmail!;
      else if (key === 'message' && v.length < 10) msg = ds.errShort!;
      el.setAttribute('aria-invalid', String(!!msg));
      document.getElementById(`${el.id}-err`)!.textContent = msg;
      return !msg;
    };

    (Object.keys(fields) as (keyof typeof fields)[]).forEach((k) => {
      fields[k].addEventListener('blur', () => fields[k].value && check(k));
      fields[k].addEventListener('input', () => fields[k].getAttribute('aria-invalid') === 'true' && check(k));
    });

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      label.hidden = busy;
      sending.hidden = !busy;
    };
    const show = (state: 'ok' | 'err' | null) => {
      ok.hidden = state !== 'ok';
      err.hidden = state !== 'err';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      show(null);
      const results = (Object.keys(fields) as (keyof typeof fields)[]).map(check);
      if (results.includes(false)) {
        (Object.values(fields).find((f) => f.getAttribute('aria-invalid') === 'true') as HTMLElement)?.focus();
        return;
      }

      const data = new FormData(form);
      // Anti-spam: honeypot filled or submitted too fast → pretend success, send nothing.
      if (data.get('website') || Date.now() - startedAt < 3000) {
        show('ok');
        form.reset();
        return;
      }

      setBusy(true);
      try {
        const payload = {
          access_key: ds.key,
          subject: `DefHat — запит із сайту (${ds.lang?.toUpperCase()})`,
          from_name: 'DefHat website',
          name: String(data.get('name')).trim(),
          email: String(data.get('email')).trim(),
          company: String(data.get('company') || '').trim(),
          message: String(data.get('message')).trim(),
          language: ds.lang,
        };

        if (!ds.endpoint) {
          if (!ds.dev) throw new Error('Form endpoint is not configured');
          console.info('[dev] Form payload (not sent, PUBLIC_FORM_ENDPOINT is empty):', payload);
          await new Promise((r) => setTimeout(r, 900));
        } else {
          const res = await fetch(ds.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
        }
        show('ok');
        form.reset();
        Object.values(fields).forEach((f) => f.removeAttribute('aria-invalid'));
      } catch (error) {
        console.error(error);
        show('err');
      } finally {
        setBusy(false);
      }
    });
  }
</script>
