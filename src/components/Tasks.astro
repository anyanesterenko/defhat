---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).tasks;
const icons = ['search', 'build', 'integrate', 'chart', 'wave', 'box'];
// Колір плитки і місце «вузла» на нитці (x — % ширини, y — px від верху).
// Нитка проходить через вузли змійкою: ряд 1 зліва направо, ряд 2 справа наліво.
const tones = ['navy', 'light', 'dark', 'gray', 'light', 'mist'];
const nodes = [
  { x: 58, y: 58 },
  { x: 44, y: 86 },
  { x: 60, y: 54 },
  { x: 40, y: 84 },
  { x: 62, y: 56 },
  { x: 46, y: 80 },
];
---
<section id="tasks" class="section sheet tasks-sec" aria-labelledby="tasks-title" data-index="04">
  <div class="container">
    <SectionHead index={4} label={d.eyebrow} title={d.title} id="tasks-title" />

    <div class="thread-grid" data-tthread>
      <ul class="tiles">
        {d.items.map((item, i) => (
          <li class={`tile tile--${tones[i]} reveal`} style={`--d:${(i % 3) * 90}ms`}>
            <span class="tile__n mono">T—{String(i + 1).padStart(2, '0')}</span>
            <span class="tile__node" style={`--x:${nodes[i].x}%; --y:${nodes[i].y}px; --k:${i}`} data-node aria-hidden="true">
              <Icon name={icons[i % icons.length]} />
            </span>
            <div class="tile__body">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <!-- Одна нитка через усі плитки; шлях будується скриптом за положенням вузлів -->
      <svg class="thread" aria-hidden="true" data-thread-svg>
        <path class="thread__halo" data-thread-path />
        <path class="thread__line" pathLength="1" data-thread-path />
        <path class="thread__dots" data-thread-path />
      </svg>
      <span class="thread__spark" aria-hidden="true" data-thread-spark></span>
    </div>
  </div>
</section>

<style>
  .thread-grid { position: relative; margin-top: clamp(48px, 6vw, 80px); }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .tile {
    --bg: var(--surface);
    --fg: var(--text);
    --sub: var(--muted);
    --node-bg: var(--royal);
    --node-fg: #fff;
    --node-ring: rgba(0, 9, 120, 0.18);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 270px;
    padding: clamp(22px, 2.2vw, 30px);
    border-radius: var(--card-r);
    background: var(--bg);
    color: var(--fg);
    transition: box-shadow 0.6s var(--ease);
  }
  .tile:hover { box-shadow: 0 24px 48px -28px rgba(0, 9, 120, 0.45); }

  .tile--light { box-shadow: inset 0 0 0 1px rgba(14, 26, 51, 0.07); }
  .tile--navy {
    --bg: linear-gradient(160deg, #10198a, var(--royal) 60%);
    --fg: #fff;
    --sub: rgba(255, 255, 255, 0.74);
    --node-bg: #fff;
    --node-fg: var(--royal);
    --node-ring: rgba(255, 255, 255, 0.28);
  }
  .tile--dark {
    --bg: linear-gradient(160deg, #161925, var(--black));
    --fg: var(--text-on-dark);
    --sub: var(--muted-on-dark);
    --node-bg: var(--copper);
    --node-fg: var(--black);
    --node-ring: rgba(169, 173, 214, 0.28);
  }
  .tile--gray {
    --bg: linear-gradient(160deg, #c6c7ca, var(--brand-gray));
    --sub: rgba(10, 15, 69, 0.72);
    --node-ring: rgba(0, 9, 120, 0.2);
  }
  .tile--mist {
    --bg: linear-gradient(140deg, #dfe2f3, #eef0f7);
    --node-ring: rgba(0, 9, 120, 0.16);
  }

  .tile__n { position: relative; z-index: 3; color: var(--sub); }

  /* Вузол на нитці з іконкою задачі */
  .tile__node {
    position: absolute;
    z-index: 3;
    left: var(--x);
    top: var(--y);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: var(--node-bg);
    color: var(--node-fg);
    box-shadow: 0 0 0 8px var(--node-ring);
    transform: scale(0.4);
    opacity: 0;
    transition: transform 0.7s var(--ease), opacity 0.5s ease, box-shadow 0.5s var(--ease);
    transition-delay: calc(0.5s + var(--k) * 0.22s);
  }
  .is-drawn .tile__node { transform: none; opacity: 1; }
  .tile:hover .tile__node { box-shadow: 0 0 0 14px var(--node-ring); transition-delay: 0s; }
  .tile__node :global(svg) { width: 22px; height: 22px; stroke-width: 1.5; }
  .tile__node::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px solid var(--node-ring);
    opacity: 0;
  }
  .is-drawn .tile__node::after { animation: ping 3.6s ease-out infinite; animation-delay: calc(var(--k) * 0.6s + 1.5s); }
  @keyframes ping {
    0% { transform: scale(1); opacity: 1; }
    70%, 100% { transform: scale(1.8); opacity: 0; }
  }

  .tile__body { position: relative; z-index: 3; margin-top: auto; padding-top: 104px; max-width: 32ch; }
  .tile h3 { font-size: clamp(21px, 1.8vw, 25px); font-weight: 400; line-height: 1.15; letter-spacing: -0.02em; }
  .tile p { margin-top: 10px; font-size: 15.5px; color: var(--sub); }

  /* Нитка поверх плиток, під вузлами й текстом */
  .thread {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    fill: none;
  }
  .thread__halo { stroke: rgba(255, 255, 255, 0.55); stroke-width: 5; stroke-linecap: round; opacity: 0; transition: opacity 1s ease 1.6s; }
  .thread__line {
    stroke: #5a63c4;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2.6s var(--ease);
  }
  .thread__dots { stroke: #a9add6; stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 0.1 12; opacity: 0; animation: march 1.8s linear infinite; transition: opacity 1s ease 2.2s; }
  @keyframes march { to { stroke-dashoffset: -12.1; } }
  .is-drawn .thread__line { stroke-dashoffset: 0; }
  .is-drawn .thread__halo { opacity: 0.6; }
  .is-drawn .thread__dots { opacity: 0.8; }

  /* Іскра, що біжить ниткою */
  .thread__spark {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(90, 99, 196, 0.35), 0 0 18px 4px rgba(169, 173, 214, 0.8);
    offset-rotate: 0deg;
    opacity: 0;
    pointer-events: none;
  }
  .is-drawn .thread__spark { opacity: 1; animation: run 9s linear 2.6s infinite; }
  @keyframes run { from { offset-distance: 0%; } to { offset-distance: 100%; } }

  @media (max-width: 960px) {
    .tiles { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .tiles { grid-template-columns: 1fr; }
    .tile { min-height: 0; }
    .tile__node { left: calc(100% - 44px); top: 50px; width: 46px; height: 46px; margin: -23px 0 0 -23px; }
    .tile__body { padding-top: 64px; padding-right: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .thread__spark { display: none; }
  }
</style>

<script>
  type P = { x: number; y: number };

  // Плавна крива через точки (Catmull-Rom → кубічні Безьє)
  const smooth = (pts: P[]) => {
    let d = `M${pts[0].x.toFixed(1)} ${pts[0].y.toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] || pts[i];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] || p2;
      const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
      const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
      d += ` C${c1.x.toFixed(1)} ${c1.y.toFixed(1)} ${c2.x.toFixed(1)} ${c2.y.toFixed(1)} ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
    }
    return d;
  };

  document.querySelectorAll<HTMLElement>('[data-tthread]').forEach((wrap) => {
    const svg = wrap.querySelector<SVGSVGElement>('[data-thread-svg]')!;
    const paths = wrap.querySelectorAll<SVGPathElement>('[data-thread-path]');
    const spark = wrap.querySelector<HTMLElement>('[data-thread-spark]')!;
    const nodeEls = [...wrap.querySelectorAll<HTMLElement>('[data-node]')];

    const build = () => {
      const box = wrap.getBoundingClientRect();
      const W = box.width;
      const H = box.height;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      // центр вузла (масштаб анімації центрований, тож центр не зміщується)
      const pts: P[] = nodeEls.map((n) => {
        const r = n.getBoundingClientRect();
        return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
      });

      // ряди: вузли з близьким y
      const rows: P[][] = [];
      [...pts].sort((a, b) => a.y - b.y).forEach((p) => {
        const row = rows.find((r) => Math.abs(r[0].y - p.y) < 120);
        row ? row.push(p) : rows.push([p]);
      });

      const edge = 26;
      if (rows.every((r) => r.length === 1)) {
        // одна колонка: рівна нитка вздовж правого краю, повз текст
        const route: P[] = [{ x: pts[0].x, y: -edge }];
        rows.forEach((r) => route.push(r[0]));
        route.push({ x: rows[rows.length - 1][0].x, y: H + edge });
        const d = smooth(route);
        paths.forEach((p) => p.setAttribute('d', d));
        spark.style.offsetPath = `path("${d}")`;
      } else {
        // Розворот — U-подібна петля за краєм сітки: горизонтально до краю,
        // вертикально вниз уже поза плитками, і назад у наступний ряд.
        let d = '';
        rows.forEach((r, i) => r.sort((a, b) => (i % 2 ? b.x - a.x : a.x - b.x)));
        rows.forEach((r, i) => {
          const rtl = i % 2 === 1;
          const start = { x: rtl ? W + edge : -edge, y: r[0].y };
          const end = { x: rtl ? -edge : W + edge, y: r[r.length - 1].y };
          const seg = smooth([start, ...r, end]);
          d += i === 0 ? seg : seg.replace(/^M[^C]+/, ' ');
          const next = rows[i + 1];
          if (next) {
            const out = rtl ? -46 : 46;
            d += ` C${(end.x + out).toFixed(1)} ${end.y.toFixed(1)} ${(end.x + out).toFixed(1)} ${next[0].y.toFixed(1)} ${end.x.toFixed(1)} ${next[0].y.toFixed(1)}`;
          }
        });
        paths.forEach((p) => p.setAttribute('d', d));
        spark.style.offsetPath = `path("${d}")`;
      }
    };

    build();
    new ResizeObserver(build).observe(wrap);
    document.fonts?.ready.then(build);

    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { build(); wrap.classList.add('is-drawn'); o.disconnect(); }
    }, { threshold: 0.2 }).observe(wrap);
  });
</script>
