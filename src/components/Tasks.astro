---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).tasks;
const icons = ['search', 'build', 'integrate', 'chart', 'wave', 'box'];
// Варіант оформлення плитки: колір і розмір у сітці
const tones = ['royal', 'light', 'navy', 'sand', 'light', 'orange'];
const sizes = ['tall', '', '', 'wide', 'wide', ''];

// Контурні кільця з «шпилькою», як у зображенні блоку «Підхід»
const rings = [92, 74, 57, 41, 27, 15];
---
<section id="tasks" class="section sheet tasks-sec" aria-labelledby="tasks-title" data-index="04">
  <div class="container">
    <SectionHead index={4} label={d.eyebrow} title={d.title} id="tasks-title" />

    <ul class="bento">
      {d.items.map((item, i) => (
        <li class:list={['tile', `tile--${tones[i]}`, sizes[i] && `tile--${sizes[i]}`, 'reveal']} style={`--d:${(i % 3) * 90}ms`}>
          <div class="tile__top">
            <span class="tile__n mono">T—{String(i + 1).padStart(2, '0')}</span>
            <span class="tile__icon"><Icon name={icons[i % icons.length]} /></span>
          </div>

          <svg class="tile__art" viewBox="0 0 220 150" aria-hidden="true">
            <g class="tile__rings">
              {rings.map((r, k) => (
                <ellipse cx="120" cy="112" rx={r} ry={r * 0.34} style={`--k:${k}`} />
              ))}
            </g>
            <path class="tile__dots" d="M4 138 C 50 120, 70 96, 120 112 S 200 92, 216 60" />
            <line class="tile__pin" x1="120" y1="112" x2="120" y2="38" />
            <circle class="tile__head" cx="120" cy="36" r="3.2" />
            <circle class="tile__glow" cx="120" cy="112" r="9" />
            <circle class="tile__dot" cx="120" cy="112" r="3.4" />
          </svg>

          <div class="tile__body">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bento {
    margin-top: clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(320px, auto);
    grid-auto-flow: dense;
    gap: 14px;
  }
  .tile--tall { grid-row: span 2; }
  .tile--wide { grid-column: span 2; }

  .tile {
    --bg: var(--surface);
    --fg: var(--text);
    --sub: var(--muted);
    --ring: rgba(14, 26, 51, 0.22);
    --dots: var(--royal);
    --chip: rgba(14, 26, 51, 0.08);
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--card-r);
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }
  .tile:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -24px rgba(0, 9, 120, 0.45); }

  .tile--light { box-shadow: inset 0 0 0 1px rgba(14, 26, 51, 0.07); }
  .tile--royal {
    --bg: linear-gradient(160deg, #10198a, var(--royal) 55%);
    --fg: #fff;
    --sub: rgba(255, 255, 255, 0.74);
    --ring: rgba(255, 255, 255, 0.35);
    --dots: var(--copper-2);
    --chip: rgba(255, 255, 255, 0.14);
  }
  .tile--navy {
    --bg: linear-gradient(160deg, #161925, var(--black));
    --fg: var(--text-on-dark);
    --sub: var(--muted-on-dark);
    --ring: rgba(169, 173, 214, 0.45);
    --dots: var(--copper-2);
    --chip: rgba(255, 255, 255, 0.1);
  }
  .tile--sand {
    --bg: linear-gradient(120deg, #dfe2f3, #f4f5f8 55%, #e3e5ea);
    --ring: rgba(0, 9, 120, 0.3);
    --chip: rgba(0, 9, 120, 0.08);
  }
  .tile--orange {
    --bg: linear-gradient(160deg, #c4c5c8, var(--brand-gray));
    --fg: var(--text);
    --sub: rgba(10, 15, 69, 0.7);
    --ring: rgba(0, 9, 120, 0.28);
    --dots: var(--royal);
    --chip: rgba(255, 255, 255, 0.4);
  }

  .tile__top { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; }
  .tile__n { color: var(--sub); }
  .tile__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--chip);
    transition: transform 0.6s var(--ease);
  }
  .tile__icon :global(svg) { width: 22px; height: 22px; stroke-width: 1.4; }
  .tile:hover .tile__icon { transform: rotate(-12deg) scale(1.06); }

  /* Ілюстрація */
  .tile__art {
    position: absolute;
    right: 14%;
    top: 2%;
    width: 58%;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }
  .tile--tall .tile__art { width: 118%; right: -32%; top: 12%; }
  .tile--wide .tile__art { width: 52%; right: -2%; top: 4%; }
  .tile__rings ellipse {
    fill: none;
    stroke: var(--ring);
    stroke-width: 0.8;
    transform-origin: 120px 112px;
    transform-box: view-box;
    transition: transform 0.9s var(--ease);
    transition-delay: calc(var(--k) * 40ms);
  }
  .tile:hover .tile__rings ellipse { transform: scale(calc(1.06 + var(--k) * 0.035)); }
  .tile__dots { fill: none; stroke: var(--dots); stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 0.1 6; opacity: 0.9; }
  .tile__pin { stroke: var(--dots); stroke-width: 1; opacity: 0.85; }
  .tile__head { fill: var(--dots); }
  .tile__dot { fill: #ffffff; }
  .tile__glow { fill: var(--copper); opacity: 0.5; filter: blur(4px); animation: glow 2.8s ease-in-out infinite; }
  .tile:nth-child(2n) .tile__glow { animation-delay: -1.4s; }
  @keyframes glow { 50% { opacity: 0.15; } }

  .tile__body { position: relative; z-index: 2; margin-top: auto; padding-top: 120px; max-width: 30ch; }
  .tile--wide .tile__body { max-width: 34ch; }
  .tile h3 { font-size: clamp(22px, 2vw, 28px); font-weight: 400; line-height: 1.12; letter-spacing: -0.025em; }
  .tile--tall h3 { font-size: clamp(28px, 2.8vw, 40px); }
  .tile p { margin-top: 12px; font-size: 15.5px; color: var(--sub); }

  @media (max-width: 960px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .tile--tall { grid-row: span 1; }
    .tile--tall .tile__art { width: 80%; right: -10%; top: 18%; }
  }
  @media (max-width: 600px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: minmax(260px, auto); }
    .tile--wide { grid-column: auto; }
    .tile__art, .tile--wide .tile__art, .tile--tall .tile__art { width: 66%; right: 4%; top: 2%; }
    .tile__body { padding-top: 110px; }
  }
</style>
