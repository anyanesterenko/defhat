---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang).expertise;
const tones = ['royal', 'teal', 'copper', 'violet'];
---
<section id="expertise" class="section sheet" aria-labelledby="expertise-title" data-index="02">
  <div class="container">
    <SectionHead index={2} label={d.eyebrow} title={d.title} lead={d.lead} id="expertise-title" />

    <div class="cards">
      {d.items.map((item, i) => (
        <article class={`card card--${tones[i]} reveal`} style={`--d:${i * 90}ms`} data-card>
          <div class="card__blob" aria-hidden="true"></div>
          <div class="card__head">
            <div class="card__top">
              <span class="card__icon"><Icon name={item.icon} /></span>
              <span class="card__index mono">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__intro">{item.intro}</p>
            <button
              class="card__more"
              type="button"
              aria-expanded="false"
              aria-controls={`exp-panel-${i}`}
              id={`exp-btn-${i}`}
            >
              <span data-more>{d.more}</span>
              <span data-less hidden>{d.less}</span>
              <span class="card__plus"><Icon name="plus" /></span>
              <span class="sr-only">: {item.title}</span>
            </button>
          </div>

          <div class="card__panel" id={`exp-panel-${i}`} role="region" aria-labelledby={`exp-btn-${i}`}>
            <div class="card__panel-inner">
              <div class="card__details">
                <div>
                  <h4 class="mono">{d.labels.competencies}</h4>
                  <ul>{item.competencies.map((c) => <li>{c}</li>)}</ul>
                </div>
                <div>
                  <h4 class="mono">{d.labels.requests}</h4>
                  <ul>{item.requests.map((c) => <li>{c}</li>)}</ul>
                </div>
                <div class="card__support">
                  <h4 class="mono">{d.labels.support}</h4>
                  <p>{item.support}</p>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    margin-top: clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    align-items: start;
  }

  .card {
    --c1: var(--royal);
    --c2: var(--royal-2);
    --glow: rgba(0, 9, 120, 0.3);
    position: relative;
    border-radius: var(--card-r);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgba(14, 26, 51, 0.07);
    overflow: hidden;
    isolation: isolate;
    transition: background 0.6s var(--ease), color 0.6s var(--ease), box-shadow 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .card--teal { --c1: #2c3594; --c2: var(--teal); --glow: rgba(138, 143, 196, 0.4); }
  .card--copper { --c1: #6b6e85; --c2: var(--brand-gray); --glow: rgba(107, 110, 133, 0.35); }
  .card--violet { --c1: #0a0f42; --c2: #3a4288; --glow: rgba(10, 15, 66, 0.35); }

  .card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgba(14, 26, 51, 0.05), 0 30px 60px -30px var(--glow); }

  /* Жива кольорова пляма, що «дихає» */
  .card__blob {
    position: absolute;
    z-index: -1;
    right: -70px;
    top: -90px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle at 35% 35%, var(--c2), var(--c1) 55%, transparent 72%);
    opacity: 0.18;
    filter: blur(30px);
    border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    animation: morph 14s ease-in-out infinite alternate;
    transition: opacity 0.6s, transform 0.9s var(--ease);
  }
  .card:nth-child(2) .card__blob { animation-delay: -4s; }
  .card:nth-child(3) .card__blob { animation-delay: -8s; }
  .card:nth-child(4) .card__blob { animation-delay: -11s; }
  .card:hover .card__blob { opacity: 0.26; transform: scale(1.25) translate(-20px, 20px); }
  @keyframes morph {
    0% { border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%; transform: rotate(0deg); }
    50% { border-radius: 63% 37% 41% 59% / 58% 61% 39% 42%; }
    100% { border-radius: 36% 64% 52% 48% / 46% 38% 62% 54%; transform: rotate(40deg); }
  }

  .card__head {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 3vw, 40px);
    cursor: pointer;
    min-height: 330px;
  }
  .card__top { display: flex; justify-content: space-between; align-items: flex-start; }
  .card__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--c2), var(--c1));
    color: #fff;
    box-shadow: 0 12px 26px -10px var(--glow);
    transition: transform 0.7s var(--ease);
  }
  .card__icon::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 1px dashed var(--c1);
    opacity: 0.35;
    animation: spin 18s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .card__icon :global(svg) { width: 26px; height: 26px; stroke-width: 1.4; }
  .card:hover .card__icon { transform: rotate(-10deg) scale(1.05); }
  .card__index { color: var(--muted); }
  .card__title {
    margin-top: auto;
    padding-top: 52px;
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.025em;
    max-width: 16ch;
  }
  .card__intro { margin-top: 12px; color: var(--muted); font-size: 16px; max-width: 44ch; transition: color 0.6s; }

  .card__more {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding: 6px 6px 6px 18px;
    border: 0;
    border-radius: 999px;
    background: rgba(14, 26, 51, 0.06);
    color: inherit;
    font-size: 14.5px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.4s;
  }
  .card__plus {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--text);
    color: var(--paper);
    transition: transform 0.6s var(--ease), background 0.4s, color 0.4s;
  }
  .card__plus :global(svg) { width: 14px; height: 14px; }
  .card__head:hover .card__plus { background: linear-gradient(140deg, var(--c2), var(--c1)); color: #fff; }

  /* Відкрита картка: занурюється в глибокий синій, пляма спалахує */
  .card.is-open { background: var(--black); color: var(--text-on-dark); box-shadow: 0 30px 60px -30px var(--glow); }
  .card.is-open .card__blob { opacity: 0.45; transform: scale(1.6) translate(-30px, 30px); }
  .card.is-open .card__intro,
  .card.is-open .card__index { color: var(--muted-on-dark); }
  .card.is-open .card__more { background: rgba(255, 255, 255, 0.08); }
  .card.is-open .card__plus { transform: rotate(45deg); background: linear-gradient(140deg, var(--c2), var(--c1)); color: #fff; }

  .card__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease); }
  .card.is-open .card__panel { grid-template-rows: 1fr; }
  .card__panel-inner { overflow: hidden; }
  .card__details {
    display: grid;
    gap: 24px;
    margin: 0 clamp(26px, 3vw, 40px) clamp(26px, 3vw, 40px);
    padding-top: 26px;
    border-top: 1px solid rgba(214, 226, 255, 0.12);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.4s, transform 0.6s var(--ease);
  }
  .card.is-open .card__details { opacity: 1; transform: none; transition-delay: 0.15s; }
  .card__details h4 { color: var(--c2); }
  .card__details ul { margin-top: 12px; display: grid; gap: 9px; }
  .card__details li { position: relative; padding-left: 22px; font-size: 15.5px; }
  .card__details li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c2);
    box-shadow: none;
  }
  .card__support p { margin-top: 12px; font-size: 15.5px; color: var(--muted-on-dark); }

  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
    .card__head { min-height: 0; }
    .card__title { padding-top: 36px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
    const head = card.querySelector<HTMLElement>('.card__head')!;
    const btn = card.querySelector<HTMLButtonElement>('.card__more')!;
    const more = card.querySelector<HTMLElement>('[data-more]')!;
    const less = card.querySelector<HTMLElement>('[data-less]')!;
    head.addEventListener('click', () => {
      const open = !card.classList.contains('is-open');
      card.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      more.hidden = open;
      less.hidden = !open;
    });
  });
</script>
