---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { langs, t, url, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const d = t(lang);
---
<Base lang={lang} title={`${d.privacy.title} — DefHat`} description={d.meta.description} ogAlt={d.meta.ogAlt}>
  <Header lang={lang} home={false} />
  <main id="main" class="policy">
    <div class="policy__hero">
      <div class="container">
        <a class="policy__back" href={url(`${lang}/`)}>← {d.privacy.back}</a>
        <h1>{d.privacy.title}</h1>
        <p>{d.privacy.updated}</p>
      </div>
    </div>
    <div class="container policy__body">
      {d.privacy.sections.map((s) => (
        <section>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </section>
      ))}
      <section>
        <h2>{d.nav.contacts}</h2>
        <p><a href={`mailto:${d.contact.email}`}>{d.contact.email}</a></p>
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .policy__hero { background: var(--black); color: var(--text-on-dark); padding: calc(var(--header-h) + 56px) 0 56px; }
  .policy__back { font-size: 15px; color: var(--muted-on-dark); }
  .policy__back:hover { color: #fff; }
  .policy__hero h1 { margin-top: 20px; font-size: clamp(36px, 5.4vw, 64px); font-weight: 300; letter-spacing: -0.035em; line-height: 1.05; font-variation-settings: 'SHRP' 60; }
  .policy__hero p { margin-top: 12px; font-family: var(--mono); font-size: 13px; color: var(--muted-on-dark); }
  .policy__body { max-width: calc(760px + var(--gutter) * 2); padding-block: 64px 96px; display: grid; gap: 36px; }
  .policy__body h2 { font-size: 24px; font-weight: 400; letter-spacing: -0.02em; }
  .policy__body p { margin-top: 10px; color: var(--muted); }
  .policy__body a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
</style>
