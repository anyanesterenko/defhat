---
// Корінь сайту веде на українську версію; англомовних відвідувачів — на /en/.
import { url } from '../i18n';
const uk = url('uk/');
const en = url('en/');
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <title>DefHat</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={uk} />
    <script is:inline define:vars={{ uk, en }}>
      var l = ((navigator.languages && navigator.languages[0]) || navigator.language || '').toLowerCase();
      location.replace(l.indexOf('en') === 0 ? en : uk);
    </script>
    <meta http-equiv="refresh" content={`0; url=${uk}`} />
  </head>
  <body></body>
</html>
