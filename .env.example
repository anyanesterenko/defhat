# Endpoint, що приймає JSON-форму (наприклад https://api.web3forms.com/submit або Formspree).
# Якщо не задано — у режимі розробки форма імітує успішне надсилання.
PUBLIC_FORM_ENDPOINT=
# Ключ доступу сервісу форми (для Web3Forms: access_key). Лист піде на адресу, прив'язану до ключа.
PUBLIC_FORM_ACCESS_KEY=
